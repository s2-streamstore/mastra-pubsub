# S2 access token and a basin with create-stream-on-append and
# create-stream-on-read enabled (https://s2.dev/dashboard)
S2_ACCESS_TOKEN=
S2_BASIN=
# Model provider key for the default openai/gpt-4o (or set MODEL)
OPENAI_API_KEY=
# Re-drive runs left RUNNING by a crashed process on boot. Off by default,
# like Mastra's own `recovery.durableAgents`: recovery replays the agentic
# loop, so it re-issues LLM calls and re-runs tools.
# RECOVER_ON_BOOT=true
